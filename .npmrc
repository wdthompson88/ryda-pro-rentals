# Refuse to install on the wrong Node major instead of warning about it.
#
# engines.node is pinned to 24 because that is what Vercel runs in
# production for this project. Without engine-strict, npm only prints an
# EBADENGINE warning and installs anyway -- which silently rewrites
# package-lock.json in the older npm's format. That drift is invisible until
# someone commits it, and then it ping-pongs between machines.
#
# With this, a wrong-Node install fails immediately and says why. Loud beats
# silent: same principle as direct-push-guard in the verify workflow.
engine-strict=true
