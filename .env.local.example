# RYDA — local environment variables
# Copy this file to `.env.local` and fill in real values.
# All NEXT_PUBLIC_* vars are exposed to the browser; keep service-role keys server-only.

# ───────────────────────────────────────────────────────────────────────────
# Supabase Auth (member sign-in / sign-up / magic-link callback)
# Consumed by: src/lib/supabase.ts (browser client)
# Get both from: Supabase dashboard → Project Settings → API.
# Either key format works:
#   - new "publishable" format:  sb_publishable_xxxxxxxxxxxxxxxx
#   - legacy "anon" JWT:         eyJhbGciOiJIUzI1NiIs...
# When unset, /signin and /signup fall back to a simulated success path so
# the marketing site still demos cleanly without a backend.
# ───────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-OR-ANON-KEY

# ───────────────────────────────────────────────────────────────────────────
# Social sign-in providers shown on /signup and /signin.
# Comma list of Supabase OAuth provider ids; supported here:
#   google, facebook, azure   (azure = "Sign in with Microsoft")
# A button only renders for providers listed here, so enable each one in
# the Supabase dashboard (Authentication → Providers, with the provider's
# client id/secret) BEFORE adding it — an unconfigured provider's button
# would error at click time. Leave unset for email+password only.
# Consumed by: src/components/oauth-buttons.tsx
# ───────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_AUTH_PROVIDERS=

# ───────────────────────────────────────────────────────────────────────────
# Public site origin — used to build absolute URLs in OG metadata, sitemap,
# robots.txt, and email redirect-back links. No trailing slash.
# Consumed by: src/app/layout.tsx, src/app/sitemap.ts, src/app/robots.ts
# Defaults to the Vercel preview origin when unset; set this in production.
# ───────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://ryda.com

# ───────────────────────────────────────────────────────────────────────────
# Resend transactional email (server-only — DO NOT prefix NEXT_PUBLIC_)
# Consumed by: src/lib/notify.ts → /api/waitlist, /api/contact,
#              /api/help-escalation, /api/investor-inquiry
# Get the key from: https://resend.com/api-keys
# When any of these three are unset, notifyTeam() logs and no-ops, so form
# submissions still succeed — they just don't email the team.
# RYDA_NOTIFY_FROM must be a verified sender on a domain you own in Resend.
# RYDA_NOTIFY_TO is the team alias that receives lead notifications.
# ───────────────────────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RYDA_NOTIFY_FROM=RYDA <team@ryda.com>
RYDA_NOTIFY_TO=team@ryda.com

# ───────────────────────────────────────────────────────────────────────────
# Supabase service-role key (server-only — DO NOT prefix NEXT_PUBLIC_)
# Consumed by: src/lib/supabase-admin.ts → /api/share-purchase/*,
#              /api/bookings/*. Bypasses RLS for inserts/updates.
# Get from: Supabase dashboard → Project Settings → API → service_role.
# ───────────────────────────────────────────────────────────────────────────
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIs...

# ───────────────────────────────────────────────────────────────────────────
# Stripe — payments for share purchases (server-only secret key + webhook)
# + Stripe Identity (KYC) shares the same secret key.
# Consumed by: src/lib/stripe.ts → /api/share-purchase/*, /api/kyc/*
# Get keys from: https://dashboard.stripe.com/apikeys
# Webhook secret: https://dashboard.stripe.com/webhooks → Endpoint → Signing secret
# Test keys (`sk_test_…`, `whsec_test_…`) are fine for preview deployments.
# Without the secret key, the BuyFlow.FundStep falls back to the
# wire-instructions copy and no Checkout session is created.
#
# Configure TWO webhook endpoints in Stripe — Stripe assigns ONE signing
# secret per endpoint, so you need a separate env var for each:
#   1. /api/share-purchase/webhook → STRIPE_WEBHOOK_SECRET
#      Events: checkout.session.completed, checkout.session.expired,
#              payment_intent.payment_failed
#   2. /api/kyc/webhook            → STRIPE_KYC_WEBHOOK_SECRET
#      Events: identity.verification_session.verified,
#              identity.verification_session.processing,
#              identity.verification_session.requires_input,
#              identity.verification_session.canceled
# If you'd rather run a single Stripe endpoint and dispatch internally,
# leave STRIPE_KYC_WEBHOOK_SECRET unset — the KYC route falls back to
# STRIPE_WEBHOOK_SECRET.
# ───────────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_KYC_WEBHOOK_SECRET=whsec_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ───────────────────────────────────────────────────────────────────────────
# Dropbox Sign (formerly HelloSign) — e-signature for the Operating
# Agreement, Management Services Agreement, and Subscription Agreement
# in the BuyFlow's DocumentsStep.
# Consumed by: src/lib/dropbox-sign.ts → /api/documents/sign-request,
#              /api/documents/webhook
#
# Setup:
#   1. Create a Dropbox Sign account: https://app.hellosign.com/
#   2. Apps → API → create a Production / Test API key.
#   3. Apps → API → Embedded Signing → create a Client ID. Whitelist your
#      production + preview origins (e.g. https://ryda.com, https://*.vercel.app).
#   4. Templates → upload three PDFs (OA, MSA, Subscription Agreement).
#      Each template MUST define merge fields named exactly:
#        member_name, member_email, asset_label, llc_name, shares, buy_in
#      Copy each template's ID into the *_TEMPLATE_ID vars below.
#   5. Webhook → set the URL to https://your-domain.com/api/documents/webhook
#      (no signing secret in Dropbox Sign — payloads are HMAC-signed against
#      the API key itself; the route verifies)
#
# When any of these are unset, the BuyFlow's DocumentsStep falls back to
# the typed-name signature flow (the marketing demo path).
# ───────────────────────────────────────────────────────────────────────────
DROPBOX_SIGN_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DROPBOX_SIGN_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DROPBOX_SIGN_OA_TEMPLATE_ID=
DROPBOX_SIGN_MSA_TEMPLATE_ID=
DROPBOX_SIGN_SUBSCRIPTION_TEMPLATE_ID=

# ───────────────────────────────────────────────────────────────────────────
# Sentry — error monitoring for browser + server runtimes.
# Consumed by: sentry.client.config.ts, sentry.server.config.ts,
#              sentry.edge.config.ts (loaded via src/instrumentation.ts)
# Both DSNs are the SAME value but split because Next.js exposes
# NEXT_PUBLIC_* to the client bundle and server-only env names need
# to NOT have the prefix.
# Without these, Sentry inits as a no-op (zero overhead).
# Get from: https://sentry.io/settings/<org>/projects/<project>/keys/
# ───────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# ───────────────────────────────────────────────────────────────────────────
# PostHog — product analytics. Cookie-banner gated (only loads when
# the user accepts via the banner; "essential only" → no PostHog).
# Consumed by: src/lib/analytics.ts via src/components/analytics-bootstrap.tsx
# Without these, analytics is a no-op.
# Get from: https://app.posthog.com/project/settings → Project API key
# Self-hosted? Override the host.
# ───────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ───────────────────────────────────────────────────────────────────────────
# Upstash Redis — distributed rate limiter. When both are set, the
# rate-limit subsystem at lib/rate-limit/ uses Upstash for shared
# state across Vercel cold starts; otherwise falls back to in-memory
# (which desyncs across instances and is not a real DoS defense).
# Required for production. Free for dev (in-memory fallback works).
# Get from: https://console.upstash.com/redis → REST URL + REST Token
# ───────────────────────────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ───────────────────────────────────────────────────────────────────────────
# Open Generative AI / MuAPI — preferred RYDA marketing creative engine.
# Consumed by: src/lib/generative-ai/muapi.ts, src/lib/image-gen/muapi.ts,
#              src/lib/video-gen/muapi.ts, /api/admin/generate-{image,video},
#              scripts/marketing/queue-poller.ts
# Get from: https://muapi.ai / Open Generative AI account settings.
# MUAPI_BASE_URL should normally stay unset; it exists for self-host/proxy tests.
# Model vars are optional defaults matching Open Generative AI model ids/endpoints.
# ───────────────────────────────────────────────────────────────────────────
MUAPI_API_KEY=
MUAPI_BASE_URL=https://api.muapi.ai
RYDA_MUAPI_IMAGE_MODEL=qwen-image
RYDA_MUAPI_I2I_MODEL=qwen-image-edit
RYDA_MUAPI_VIDEO_MODEL=seedance-v2.0-t2v
RYDA_MUAPI_I2V_MODEL=seedance-v2.0-i2v
RYDA_MUAPI_LIPSYNC_MODEL=ltx-2.3-lipsync
RYDA_MUAPI_WORKFLOW_ID=

# ───────────────────────────────────────────────────────────────────────────
# KYC PII encryption — AES-256-GCM key for the kyc_verifications.
# verified_outputs_encrypted column. When set, the webhook encrypts
# DOB + name + address + document number at write time; decryption
# happens in lib/pii-encryption.ts. Without it, writes fall back to
# the legacy plaintext column (verified_outputs).
# Threat-model finding KYC T1: defense in depth against service-
# role key compromise + Supabase backup exfiltration.
# Generate with: openssl rand -base64 32
# ───────────────────────────────────────────────────────────────────────────
KYC_PII_ENCRYPTION_KEY=

# ───────────────────────────────────────────────────────────────────────────
# Admin MFA enforcement. When set to 'true', requireAdmin (in
# lib/admin-auth.ts) rejects any admin call where the JWT's aal
# claim is not aal2 (i.e. they have not passed TOTP step-up
# this session). When unset/false, aal1 admin calls are logged
# (warning) but allowed — used during the rollout window so the
# first admin can enroll without locking themselves out. Flip to
# 'true' once at least one admin has enrolled + verified.
# ───────────────────────────────────────────────────────────────────────────
ADMIN_MFA_REQUIRED=false
