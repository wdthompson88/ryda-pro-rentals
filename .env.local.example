# RYDA — local environment variables
# Copy this file to `.env.local` and fill in real values.
# All NEXT_PUBLIC_* vars are exposed to the browser; keep service-role keys server-only.

# ───────────────────────────────────────────────────────────────────────────
# Supabase Auth (member sign-in / sign-up / magic-link callback)
# Consumed by: src/lib/supabase.ts (browser client)
# Get both from: Supabase dashboard → Project Settings → API.
# Either key format works:
#   - new "publishable" format:  sb_publishable_xxxxxxxxxxxxxxxx
#   - legacy "anon" JWT:         eyJhbGciOiJIUzI1NiIs...
# When unset, /signin and /signup fall back to a simulated success path so
# the marketing site still demos cleanly without a backend.
# ───────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-OR-ANON-KEY

# ───────────────────────────────────────────────────────────────────────────
# Public site origin — used to build absolute URLs in OG metadata, sitemap,
# robots.txt, and email redirect-back links. No trailing slash.
# Consumed by: src/app/layout.tsx, src/app/sitemap.ts, src/app/robots.ts
# Defaults to the Vercel preview origin when unset; set this in production.
# ───────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://ryda.com

# ───────────────────────────────────────────────────────────────────────────
# Resend transactional email (server-only — DO NOT prefix NEXT_PUBLIC_)
# Consumed by: src/lib/notify.ts → /api/waitlist, /api/contact,
#              /api/help-escalation, /api/investor-inquiry
# Get the key from: https://resend.com/api-keys
# When any of these three are unset, notifyTeam() logs and no-ops, so form
# submissions still succeed — they just don't email the team.
# RYDA_NOTIFY_FROM must be a verified sender on a domain you own in Resend.
# RYDA_NOTIFY_TO is the team alias that receives lead notifications.
# ───────────────────────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RYDA_NOTIFY_FROM=RYDA <team@ryda.com>
RYDA_NOTIFY_TO=team@ryda.com

# ───────────────────────────────────────────────────────────────────────────
# Supabase service-role key (server-only — DO NOT prefix NEXT_PUBLIC_)
# Consumed by: src/lib/supabase-admin.ts → /api/share-purchase/*,
#              /api/bookings/*. Bypasses RLS for inserts/updates.
# Get from: Supabase dashboard → Project Settings → API → service_role.
# ───────────────────────────────────────────────────────────────────────────
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIs...

# ───────────────────────────────────────────────────────────────────────────
# Stripe — payments for share purchases (server-only secret key + webhook)
# + Stripe Identity (KYC) shares the same secret key.
# Consumed by: src/lib/stripe.ts → /api/share-purchase/*, /api/kyc/*
# Get keys from: https://dashboard.stripe.com/apikeys
# Webhook secret: https://dashboard.stripe.com/webhooks → Endpoint → Signing secret
# Test keys (`sk_test_…`, `whsec_test_…`) are fine for preview deployments.
# Without the secret key, the BuyFlow.FundStep falls back to the
# wire-instructions copy and no Checkout session is created.
#
# Configure TWO webhook endpoints in Stripe (both share the same signing
# secret if you reuse one endpoint, or use separate STRIPE_WEBHOOK_SECRET
# values per endpoint and we'd need to split env vars):
#   1. /api/share-purchase/webhook
#      Events: checkout.session.completed, checkout.session.expired,
#              payment_intent.payment_failed
#   2. /api/kyc/webhook
#      Events: identity.verification_session.verified,
#              identity.verification_session.processing,
#              identity.verification_session.requires_input,
#              identity.verification_session.canceled
# ───────────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ───────────────────────────────────────────────────────────────────────────
# Dropbox Sign (formerly HelloSign) — e-signature for the Operating
# Agreement, Management Services Agreement, and Subscription Agreement
# in the BuyFlow's DocumentsStep.
# Consumed by: src/lib/dropbox-sign.ts → /api/documents/sign-request,
#              /api/documents/webhook
#
# Setup:
#   1. Create a Dropbox Sign account: https://app.hellosign.com/
#   2. Apps → API → create a Production / Test API key.
#   3. Apps → API → Embedded Signing → create a Client ID. Whitelist your
#      production + preview origins (e.g. https://ryda.com, https://*.vercel.app).
#   4. Templates → upload three PDFs (OA, MSA, Subscription Agreement).
#      Each template MUST define merge fields named exactly:
#        member_name, member_email, asset_label, llc_name, shares, buy_in
#      Copy each template's ID into the *_TEMPLATE_ID vars below.
#   5. Webhook → set the URL to https://your-domain.com/api/documents/webhook
#      (no signing secret in Dropbox Sign — payloads are HMAC-signed against
#      the API key itself; the route verifies)
#
# When any of these are unset, the BuyFlow's DocumentsStep falls back to
# the typed-name signature flow (the marketing demo path).
# ───────────────────────────────────────────────────────────────────────────
DROPBOX_SIGN_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DROPBOX_SIGN_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DROPBOX_SIGN_OA_TEMPLATE_ID=
DROPBOX_SIGN_MSA_TEMPLATE_ID=
DROPBOX_SIGN_SUBSCRIPTION_TEMPLATE_ID=
