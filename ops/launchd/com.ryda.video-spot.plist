<?xml version="1.0" encoding="UTF-8"?>
<!--
  com.ryda.video-spot.plist — daily 15-second spot generator.

  Runs marketing:daily-spot once per hour. The script is idempotent
  via a day-marker file at ~/.ryda-marketing/daily-markers/, so
  hourly invocation produces exactly one spot per calendar day.

  Why hourly instead of "at 9am daily"? If your Mac is asleep at
  9am, a once-daily plist silently skips. Hourly + day-marker
  catches the next time your Mac is awake without creating duplicates.

  Install:
    1. Replace /Users/odinpartners/Desktop/dev/ryda-web with absolute path to ryda-web checkout,
       e.g. /Users/yourname/Desktop/dev/ryda-web
    2. Replace /opt/homebrew/bin/npm with the absolute path to npm
       (run `which npm` to find it)
    3. Save as ~/Library/LaunchAgents/com.ryda.video-spot.plist
    4. Load: launchctl load ~/Library/LaunchAgents/com.ryda.video-spot.plist
    5. Verify: launchctl list | grep com.ryda
    6. Tail logs: tail -f /tmp/ryda-video-spot.{out,err}

  Uninstall:
    launchctl unload ~/Library/LaunchAgents/com.ryda.video-spot.plist
    rm ~/Library/LaunchAgents/com.ryda.video-spot.plist

  Manual one-off:
    cd /Users/odinpartners/Desktop/dev/ryda-web && npm run marketing:daily-spot -- --force
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ryda.video-spot</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/npm</string>
        <string>run</string>
        <string>marketing:daily-spot</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/odinpartners/Desktop/dev/ryda-web</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <!--
          Supabase env should come from /Users/odinpartners/Desktop/dev/ryda-web/.env (loaded
          by your shell or the script). Don't hardcode here.
        -->
    </dict>

    <key>StartInterval</key>
    <integer>3600</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/tmp/ryda-video-spot.out</string>

    <key>StandardErrorPath</key>
    <string>/tmp/ryda-video-spot.err</string>
</dict>
</plist>
