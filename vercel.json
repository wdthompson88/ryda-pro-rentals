{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "next build",
  "framework": "nextjs",
  "regions": ["iad1"],
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://js.stripe.com https://checkout.stripe.com https://*.dropboxsign.com https://*.hellosign.com; connect-src 'self' https://*.supabase.co https://api.stripe.com https://checkout.stripe.com https://*.dropboxsign.com https://*.hellosign.com; frame-src https://js.stripe.com https://checkout.stripe.com https://*.dropboxsign.com https://*.hellosign.com; img-src 'self' data: https://*.unsplash.com https://images.unsplash.com https://q.stripe.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; report-uri /api/csp-report"
        }
      ]
    }
  ],
  "functions": {
    "src/app/api/share-purchase/webhook/route.ts": { "maxDuration": 30 },
    "src/app/api/share-purchase/dispute/route.ts": { "maxDuration": 15 },
    "src/app/api/kyc/webhook/route.ts": { "maxDuration": 15 },
    "src/app/api/share-purchase/[id]/resend-amendment/route.ts": { "maxDuration": 30 },
    "src/app/api/share-purchase/[id]/refund/route.ts": { "maxDuration": 20 },
    "src/app/api/cron/social-publisher/route.ts": { "maxDuration": 60 },
    "src/app/api/admin/generate-video/route.ts": { "maxDuration": 600 }
  },
  "crons": [
    {
      "path": "/api/cron/expire-transfers",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/reconcile-pending-purchases",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/template-hash-check",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/social-publisher",
      "schedule": "*/15 * * * *"
    }
  ]
}
